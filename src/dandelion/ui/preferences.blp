using Gtk 4.0;
using Adw 1;

template $DandelionPreferences: Adw.PreferencesDialog {
  search-enabled: true;

  Adw.PreferencesPage roles_page {
    name: "roles";
    title: _("Roles");
    icon-name: "system-users-symbolic";

    Adw.PreferencesGroup roles_group {
      title: _("Roles");
      description: _("A role bundles profiles, language, visibility and a signature, for example “Private” or “Blog”.");

      ListBox roles_list {
        selection-mode: none;

        styles [
          "boxed-list",
        ]
      }
    }

    Adw.PreferencesGroup profiles_group {
      title: _("Profiles");
      description: _("Login data is stored in the system keyring.");

      ListBox profiles_list {
        selection-mode: none;

        styles [
          "boxed-list",
        ]
      }
    }
  }

  Adw.PreferencesPage general_page {
    name: "general";
    title: _("General");
    icon-name: "preferences-system-symbolic";

    Adw.PreferencesGroup {
      title: _("Writing");

      Adw.SwitchRow alt_everywhere_row {
        title: _("Require Alt Text Everywhere");
        subtitle: _("Mastodon always requires alt text. Other platforms only show a warning unless this is enabled.");
      }

      Adw.SwitchRow spellcheck_row {
        title: _("Check Spelling");
      }

      Adw.SwitchRow signature_row {
        title: _("Append Role Signature");
        subtitle: _("Can be turned off for each post");
      }

      Adw.SwitchRow preview_row {
        title: _("Show Preview");
      }

      Adw.ComboRow numbering_row {
        title: _("Thread Numbering");
        subtitle: _("Added to every part of a thread");

        model: StringList {
          strings [
            _("None"),
            "1/3",
            "🧵 1/3",
          ]
        };
      }
    }

    Adw.PreferencesGroup {
      title: _("Drafts");

      Adw.SpinRow retention_row {
        title: _("Delete Empty Drafts After");
        subtitle: _("Days, 0 keeps them forever");

        adjustment: Adjustment {
          lower: 0;
          upper: 365;
          step-increment: 1;
          page-increment: 7;
        };
      }
    }
  }

  Adw.PreferencesPage scheduling_page {
    name: "scheduling";
    title: _("Scheduling");
    icon-name: "alarm-symbolic";

    Adw.PreferencesGroup {
      title: _("Background Service");
      description: _("Publishes scheduled posts even when the Dandelion window is closed.");

      Adw.SwitchRow service_row {
        title: _("Publish in the Background");
      }

      Adw.ActionRow next_row {
        title: _("Next Post");
      }
    }

    Adw.PreferencesGroup {
      title: _("Notifications");

      Adw.SwitchRow notify_success_row {
        title: _("When a Scheduled Post Was Published");
      }

      Adw.SwitchRow notify_failure_row {
        title: _("When a Scheduled Post Failed");
      }
    }

    Adw.PreferencesGroup {
      title: _("Missed Posts");
      description: _("What happens when the computer was off or asleep at the planned time.");

      Adw.ComboRow missed_row {
        title: _("Action");

        model: StringList {
          strings [
            _("Ask"),
            _("Send Anyway"),
            _("Do Not Send"),
          ]
        };
      }

      Adw.SpinRow grace_row {
        title: _("Counts as Missed After");
        subtitle: _("Minutes after the planned time");

        adjustment: Adjustment {
          lower: 1;
          upper: 1440;
          step-increment: 5;
          page-increment: 60;
        };
      }
    }

    Adw.PreferencesGroup {
      title: _("Time Zone");

      Adw.ComboRow tz_row {
        title: _("Default Time Zone");
        enable-search: true;
      }
    }
  }

  Adw.PreferencesPage ai_page {
    name: "ai";
    title: _("AI");
    icon-name: "starred-symbolic";

    Adw.PreferencesGroup {
      title: _("AI Assistant");
      description: _("Suggestions for wording, translations, hashtags and alt text. Nothing is changed without your confirmation.");

      Adw.SwitchRow ai_enabled_row {
        title: _("Enable AI Features");
      }
    }

    Adw.PreferencesGroup ai_provider_group {
      title: _("Provider");

      Adw.ComboRow provider_row {
        title: _("Provider");

        model: StringList {
          strings [
            "Google Gemini",
            "OpenAI",
            "xAI Grok",
            "OpenRouter",
          ]
        };
      }

      Adw.PasswordEntryRow key_row {
        title: _("API Key");
        show-apply-button: true;
        apply => $on_key_apply();
      }

      Adw.ButtonRow {
        title: _("Get an API Key");
        end-icon-name: "adw-external-link-symbolic";
        activated => $on_key_link();
      }

      Adw.ComboRow model_row {
        title: _("Model");
        enable-search: true;
      }

      Adw.ButtonRow load_models_row {
        title: _("Load Available Models");
        start-icon-name: "view-refresh-symbolic";
        activated => $on_load_models();
      }
    }

    Adw.PreferencesGroup {
      title: _("Privacy");
      description: _("Before text or images are sent to a provider for the first time, Dandelion asks for confirmation. API keys are stored in the system keyring.");

      Adw.ButtonRow {
        title: _("Show Privacy Notices Again");
        activated => $on_reset_privacy();
      }
    }
  }
}
