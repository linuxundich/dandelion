using Gtk 4.0;
using Adw 1;

template $DandelionAltTextDialog: Adw.Dialog {
  title: _("Alt Text");
  content-width: 520;
  content-height: 640;
  default-widget: done_button;

  child: Adw.ToolbarView {
    [top]
    Adw.HeaderBar {
      show-end-title-buttons: false;
      show-start-title-buttons: false;

      [start]
      Button {
        label: _("_Cancel");
        use-underline: true;
        clicked => $on_cancel();
      }

      [end]
      Button done_button {
        label: _("_Done");
        use-underline: true;
        clicked => $on_done();

        styles [
          "suggested-action",
        ]
      }
    }

    content: ScrolledWindow {
      hscrollbar-policy: never;

      child: Box {
        orientation: vertical;
        spacing: 12;
        margin-top: 12;
        margin-bottom: 18;
        margin-start: 18;
        margin-end: 18;

        Picture picture {
          content-fit: contain;
          can-shrink: true;
          height-request: 240;

          styles [
            "card",
          ]
        }

        Label {
          label: _("Describe the image for people who cannot see it.");
          wrap: true;
          xalign: 0;

          styles [
            "dim-label",
          ]
        }

        Frame {
          child: ScrolledWindow {
            min-content-height: 140;
            hscrollbar-policy: never;

            child: TextView text_view {
              wrap-mode: word_char;
              top-margin: 10;
              bottom-margin: 10;
              left-margin: 10;
              right-margin: 10;
              accepts-tab: false;

              accessibility {
                label: _("Alt text");
              }
            };
          };

          styles [
            "view",
          ]
        }

        Label counter_label {
          xalign: 0;

          styles [
            "caption",
            "numeric",
          ]
        }

        Button ai_button {
          visible: false;
          halign: start;
          clicked => $on_ai_generate();

          child: Adw.ButtonContent {
            icon-name: "starred-symbolic";
            label: _("_Describe Image");
            use-underline: true;
          };
        }

        Revealer ai_revealer {
          transition-type: slide_down;

          child: Box {
            orientation: vertical;
            spacing: 8;

            Box {
              spacing: 8;

              Label ai_status {
                hexpand: true;
                xalign: 0;
                wrap: true;

                styles [
                  "heading",
                ]
              }

              Adw.Spinner ai_spinner {}
            }

            Label ai_result {
              wrap: true;
              xalign: 0;
              selectable: true;
            }

            Box {
              spacing: 6;

              Entry ai_chat_entry {
                hexpand: true;
                visible: false;
                placeholder-text: _("Ask for changes, e.g. “shorter” or “mention the cable”");
                activate => $on_ai_chat();
              }

              Button ai_chat_send {
                visible: false;
                icon-name: "paper-plane-symbolic";
                tooltip-text: _("Send");
                clicked => $on_ai_chat();

                styles [
                  "flat",
                ]
              }
            }

            Box {
              spacing: 6;
              halign: end;

              Button {
                label: _("_Discard");
                use-underline: true;
                clicked => $on_ai_discard();
              }

              Button ai_accept {
                label: _("_Apply");
                use-underline: true;
                sensitive: false;
                clicked => $on_ai_accept();
              }
            }

            styles [
              "ai-panel",
            ]
          };
        }

        Label hint_label {
          xalign: 0;
          wrap: true;
          visible: false;

          styles [
            "caption",
            "dim-label",
          ]
        }
      };
    };
  };
}
