using Gtk 4.0;
using Adw 1;

Adw.ShortcutsDialog shortcuts_dialog {
  Adw.ShortcutsSection {
    title: _("Writing");

    Adw.ShortcutsItem {
      title: _("New Post");
      accelerator: "<Control>n";
    }

    Adw.ShortcutsItem {
      title: _("Publish");
      accelerator: "<Control>Return";
    }

    Adw.ShortcutsItem {
      title: _("Schedule");
      accelerator: "<Control><Shift>Return";
    }

    Adw.ShortcutsItem {
      title: _("Save Draft");
      accelerator: "<Control>s";
    }

    Adw.ShortcutsItem {
      title: _("Add Images");
      accelerator: "<Control>o";
    }

    Adw.ShortcutsItem {
      title: _("Choose Role");
      accelerator: "<Control>r";
    }

    Adw.ShortcutsItem {
      title: _("Undo");
      accelerator: "<Control>z";
    }

    Adw.ShortcutsItem {
      title: _("Redo");
      accelerator: "<Control><Shift>z";
    }
  }

  Adw.ShortcutsSection {
    title: _("View");

    Adw.ShortcutsItem {
      title: _("Compose");
      accelerator: "<Control>1";
    }

    Adw.ShortcutsItem {
      title: _("Calendar");
      accelerator: "<Control>2";
    }

    Adw.ShortcutsItem {
      title: _("Published");
      accelerator: "<Control>3";
    }

    Adw.ShortcutsItem {
      title: _("Read");
      accelerator: "<Control>4";
    }

    Adw.ShortcutsItem {
      title: _("Show Preview");
      accelerator: "F9";
    }

    Adw.ShortcutsItem {
      title: _("Search Posts");
      accelerator: "<Control>f";
    }
  }

  Adw.ShortcutsSection {
    title: _("Reading");

    Adw.ShortcutsItem {
      title: _("Next or Previous Post");
      accelerator: "j k";
    }

    Adw.ShortcutsItem {
      title: _("Next or Previous Column");
      accelerator: "l h";
    }

    Adw.ShortcutsItem {
      title: _("Top of the List");
      accelerator: "g";
    }

    Adw.ShortcutsItem {
      title: _("Home, Notifications, Messages");
      accelerator: "1 2 3";
    }

    Adw.ShortcutsItem {
      title: _("Reply");
      accelerator: "r";
    }

    Adw.ShortcutsItem {
      title: _("Boost");
      accelerator: "b";
    }

    Adw.ShortcutsItem {
      title: _("Favourite");
      accelerator: "f";
    }

    Adw.ShortcutsItem {
      title: _("Bookmark");
      accelerator: "m";
    }

    Adw.ShortcutsItem {
      title: _("Open in Browser");
      accelerator: "o";
    }

    Adw.ShortcutsItem {
      title: _("New Post as This Profile");
      accelerator: "n";
    }

    Adw.ShortcutsItem {
      title: _("Refresh All Columns");
      accelerator: "F5";
    }
  }

  Adw.ShortcutsSection {
    title: _("General");

    Adw.ShortcutsItem {
      title: _("Preferences");
      accelerator: "<Control>comma";
    }

    Adw.ShortcutsItem {
      title: _("Keyboard Shortcuts");
      accelerator: "<Control>question";
    }

    Adw.ShortcutsItem {
      title: _("Close Window");
      accelerator: "<Control>w";
    }

    Adw.ShortcutsItem {
      title: _("Quit");
      accelerator: "<Control>q";
    }
  }
}
