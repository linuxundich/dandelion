using Gtk 4.0;
using Adw 1;
using GtkSource 5;

template $DandelionComposer: Adw.BreakpointBin {
  width-request: 360;
  height-request: 294;

  child: Stack main_stack {
    transition-type: crossfade;

    StackPage {
      name: "no-profiles";

      child: Adw.StatusPage {
        icon-name: "de.linuxundich.Dandelion-symbolic";
        title: _("Welcome to Dandelion");
        description: _("Add your Mastodon and Bluesky profiles to write a post once and publish it everywhere.");

        child: Button {
          label: _("_Add Profile");
          use-underline: true;
          halign: center;
          clicked => $on_add_profile_clicked();

          styles [
            "pill",
            "suggested-action",
          ]
        };
      };
    }

    StackPage {
      name: "composer";

      child: Adw.MultiLayoutView layout_view {

        Adw.Layout {
          name: "wide";

          content: Adw.OverlaySplitView preview_split {
            sidebar-position: end;
            min-sidebar-width: 320;
            max-sidebar-width: 900;
            sidebar-width-fraction: 0.4;

            content: Adw.LayoutSlot {
              id: "editor";
            };

            sidebar: Adw.LayoutSlot {
              id: "preview";
            };
          };
        }

        Adw.Layout {
          name: "narrow";

          content: Adw.BottomSheet sheet {
            content: Adw.LayoutSlot {
              id: "editor";
            };

            sheet: Adw.LayoutSlot {
              id: "preview";
            };

            bottom-bar: Box {
              margin-start: 12;
              margin-end: 12;
              margin-top: 10;
              margin-bottom: 10;
              spacing: 6;

              Label sheet_bar_label {
                hexpand: true;
                xalign: 0;
                ellipsize: end;
                label: _("Preview");
              }

              Image {
                icon-name: "go-up-symbolic";
              }
            };
          };
        }

        [editor]
        Box editor_box {
          orientation: vertical;

          Adw.Banner schedule_banner {
            button-label: _("_Unschedule");
            button-clicked => $on_unschedule();
          }

          Adw.Clamp {
            maximum-size: 760;
            tightening-threshold: 760;

            child: Box {
              orientation: vertical;
              spacing: 10;
              margin-top: 14;
              margin-start: 16;
              margin-end: 16;

              Adw.WrapBox chips_box {
                child-spacing: 6;
                line-spacing: 6;

                Label from_label {
                  valign: center;
                  /* Translators: "From role to profiles", like in an e-mail */
                  label: C_("recipients", "From");

                  styles [
                    "dim-label",
                  ]
                }

                MenuButton role_button {
                  tooltip-text: _("Role");
                  popover: role_popover;

                  child: Box {
                    spacing: 6;

                    Label role_emoji {}

                    Label role_label {
                      ellipsize: end;

                      styles [
                        "heading",
                      ]
                    }

                    Image {
                      icon-name: "pan-down-symbolic";
                    }
                  };

                  styles [
                    "flat",
                    "role-button",
                  ]
                }

                Label to_label {
                  valign: center;
                  /* Translators: "Role to profiles", like "From … to …" in an e-mail */
                  label: C_("recipients", "to");

                  styles [
                    "dim-label",
                  ]
                }
              }

              Box card_head {
                spacing: 10;
                visible: false;

                Adw.ToggleGroup variant_group {
                  homogeneous: false;
                  halign: start;
                  valign: center;
                  notify::active-name => $on_variant_changed();
                }

                Box variant_info {
                  spacing: 6;
                  visible: false;
                  hexpand: true;

                  Label variant_info_label {
                    hexpand: true;
                    xalign: 0;
                    wrap: true;

                    styles [
                      "caption",
                      "dim-label",
                    ]
                  }

                  Button variant_info_button {
                    use-underline: true;
                    valign: center;
                    clicked => $on_variant_banner_clicked();

                    styles [
                      "flat",
                      "small-button",
                    ]
                  }
                }
              }

              Revealer cw_revealer {
                transition-type: slide_down;

                child: Entry cw_entry {
                  placeholder-text: _("Content warning");
                  primary-icon-name: "dialog-warning-symbolic";
                  changed => $on_cw_changed();

                  accessibility {
                    label: _("Content warning");
                  }
                };
              }
            };
          }

          Overlay text_overlay {
            vexpand: true;

            child: ScrolledWindow text_scroller {
              hscrollbar-policy: never;
              min-content-height: 160;

              child: GtkSource.View text_view {
                wrap-mode: word_char;
                top-margin: 12;
                bottom-margin: 24;
                left-margin: 16;
                right-margin: 16;
                accepts-tab: false;

                accessibility {
                  label: _("Post text");
                }

                styles [
                  "composer-text",
                ]
              };
            };

            [overlay]
            Label placeholder_label {
              label: _("What’s new?");
              halign: start;
              valign: start;
              can-target: false;
              margin-top: 12;
              margin-start: 16;

              styles [
                "composer-text",
                "composer-placeholder",
              ]
            }
          }

          Adw.Clamp {
            maximum-size: 760;
            tightening-threshold: 760;

            child: Box {
              orientation: vertical;
              margin-start: 16;
              margin-end: 16;

              Revealer ai_revealer {
                transition-type: slide_up;

                child: Box {
                  orientation: vertical;
                  spacing: 8;
                  margin-bottom: 10;

                  Box {
                    spacing: 8;

                    Image {
                      icon-name: "starred-symbolic";
                    }

                    Label ai_title {
                      hexpand: true;
                      xalign: 0;
                      ellipsize: end;

                      styles [
                        "heading",
                      ]
                    }

                    Adw.Spinner ai_spinner {}
                  }

                  Label ai_result {
                    wrap: true;
                    wrap-mode: word_char;
                    xalign: 0;
                    selectable: true;
                  }

                  Adw.WrapBox ai_tags {
                    child-spacing: 6;
                    line-spacing: 6;
                    visible: false;
                  }

                  Box ai_actions {
                    spacing: 6;
                    halign: end;

                    Button {
                      label: _("_Discard");
                      use-underline: true;
                      clicked => $on_ai_discard();
                    }

                    Button ai_retry_button {
                      label: _("_Try Again");
                      use-underline: true;
                      clicked => $on_ai_retry();
                    }

                    Button ai_accept_button {
                      label: _("_Apply");
                      use-underline: true;
                      clicked => $on_ai_accept();
                    }
                  }

                  styles [
                    "ai-panel",
                  ]
                };
              }

              ScrolledWindow media_box {
                visible: false;
                vscrollbar-policy: never;
                propagate-natural-height: true;
                margin-bottom: 10;

                child: Box media_tiles {
                  spacing: 8;
                };
              }
            };
          }

          Box toolbar {
            styles [
              "composer-toolbar",
            ]

            Adw.Clamp {
              hexpand: true;
              maximum-size: 760;
              tightening-threshold: 760;

              child: Box {
                spacing: 2;
                margin-start: 10;
                margin-end: 10;

                Button add_media_button {
                  icon-name: "insert-image-symbolic";
                  tooltip-text: _("Add Images");

                  accessibility {
                    label: _("Add Images");
                  }
                  action-name: "win.add-media";

                  styles [
                    "flat",
                  ]
                }

                Button emoji_button {
                  icon-name: "face-smile-symbolic";
                  tooltip-text: _("Insert Emoji");
                  clicked => $on_emoji_clicked();

                  accessibility {
                    label: _("Insert Emoji");
                  }

                  styles [
                    "flat",
                  ]
                }

                ToggleButton cw_button {
                  icon-name: "dialog-warning-symbolic";
                  tooltip-text: _("Content Warning");
                  toggled => $on_cw_toggled();

                  accessibility {
                    label: _("Content Warning");
                  }

                  styles [
                    "flat",
                  ]
                }

                ToggleButton thread_button {
                  visible: false;
                  icon-name: "view-list-ordered-symbolic";
                  tooltip-text: _("Split into a thread when the text is too long. A line with only “---” sets a break by hand.");
                  toggled => $on_thread_toggled();

                  accessibility {
                    label: _("Thread");
                  }

                  styles [
                    "flat",
                  ]
                }

                MenuButton ai_button {
                  visible: false;
                  icon-name: "starred-symbolic";
                  tooltip-text: _("Writing Assistant");

                  accessibility {
                    label: _("Writing Assistant");
                  }

                  styles [
                    "flat",
                  ]
                }

                Box {
                  hexpand: true;
                }

                MenuButton issues_button {
                  visible: false;
                  valign: center;
                  popover: issues_popover;
                  tooltip-text: _("Problems");

                  child: Box {
                    spacing: 6;

                    Image issues_icon {
                      icon-name: "dialog-warning-symbolic";
                    }

                    Label issues_label {}
                  };

                  styles [
                    "flat",
                  ]
                }

                MenuButton options_button {
                  popover: options_popover;
                  tooltip-text: _("Post Options");

                  child: Adw.ButtonContent options_content {
                    icon-name: "emblem-system-symbolic";
                    can-shrink: true;
                  };

                  styles [
                    "flat",
                  ]
                }

                $DandelionCounterRing strict_counter {
                  valign: center;
                  margin-start: 6;
                  margin-end: 4;
                }
              };
            }
          }

          styles [
            "view",
          ]
        }

        [preview]
        ScrolledWindow preview_scroller {
          hscrollbar-policy: never;

          child: Box preview_box {
            orientation: vertical;
            spacing: 12;
            margin-top: 12;
            margin-bottom: 18;
            margin-start: 12;
            margin-end: 12;

            Box {
              spacing: 8;

              Label {
                label: _("Preview");
                xalign: 0;

                styles [
                  "heading",
                ]
              }

              Box preview_summary {
                spacing: 4;
                halign: end;
                hexpand: true;

                Image preview_summary_icon {
                  pixel-size: 14;
                }

                Label preview_summary_label {
                  ellipsize: end;

                  styles [
                    "caption-heading",
                  ]
                }
              }
            }

            Box filter_hint {
              spacing: 6;
              visible: false;

              Label filter_label {
                hexpand: true;
                xalign: 0;
                ellipsize: end;

                styles [
                  "caption",
                  "dim-label",
                ]
              }

              Button {
                label: _("Show _All");
                use-underline: true;
                clicked => $on_show_all_previews();

                styles [
                  "flat",
                  "caption",
                ]
              }
            }

            Box preview_tiles {
              spacing: 12;
              homogeneous: true;

              Box preview_col_start {
                orientation: vertical;
                spacing: 12;
                valign: start;
              }

              Box preview_col_end {
                orientation: vertical;
                spacing: 12;
                valign: start;
                visible: false;
              }
            }
          };

          styles [
            "preview-pane",
          ]
        }
      };
    }
  };

  Adw.Breakpoint {
    condition ("max-width: 860sp")

    setters {
      preview_split.collapsed: true;
      preview_split.show-sidebar: false;
      preview_split.max-sidebar-width: 420;
    }
  }

  Adw.Breakpoint {
    condition ("max-width: 700sp")

    setters {
      layout_view.layout-name: "narrow";
    }
  }
}

Popover role_popover {
  child: Box {
    orientation: vertical;
    spacing: 6;

    ListBox role_list {
      selection-mode: none;
      row-activated => $on_role_activated();

      styles [
        "navigation-sidebar",
      ]
    }

    Separator {}

    Button {
      label: _("_Manage Roles");
      use-underline: true;
      action-name: "win.manage-roles";

      styles [
        "flat",
      ]
    }
  };
}

Popover issues_popover {
  child: ScrolledWindow {
    propagate-natural-height: true;
    propagate-natural-width: true;
    max-content-height: 420;
    hscrollbar-policy: never;

    child: Box issues_list {
      orientation: vertical;
      spacing: 12;
      margin-top: 6;
      margin-bottom: 6;
      margin-start: 6;
      margin-end: 6;
      width-request: 280;
    };
  };
}

Popover options_popover {
  child: Box {
    orientation: vertical;
    spacing: 12;
    margin-top: 6;
    margin-bottom: 6;
    margin-start: 6;
    margin-end: 6;
    width-request: 320;

    Adw.PreferencesGroup {
      title: _("All Profiles");

      Adw.ComboRow language_dropdown {
        title: _("Language");
        enable-search: true;
      }

      Adw.SwitchRow signature_button {
        title: _("Append Signature");
        notify::active => $on_signature_toggled();
      }
    }

    Adw.PreferencesGroup mastodon_options {
      title: "Mastodon";

      Adw.ComboRow visibility_dropdown {
        title: _("Visibility");
      }
    }

    Adw.PreferencesGroup bluesky_options {
      title: "Bluesky";

      Adw.ComboRow label_dropdown {
        title: _("Content Label");
      }
    }
  };
}
