using Gtk 4.0;
using Adw 1;

template $DandelionScheduledView: Adw.BreakpointBin {
  width-request: 360;
  height-request: 294;

  child: Box {
    orientation: vertical;

    Adw.Banner service_banner {
      title: _("Scheduled posts are only sent while Dandelion is open.");
      button-label: _("_Enable Background Service");
      button-clicked => $on_enable_service();
    }

    ScrolledWindow {
      vexpand: true;
      hscrollbar-policy: never;

      child: Box {
        orientation: vertical;
        spacing: 12;
        margin-top: 12;
        margin-bottom: 18;
        margin-start: 18;
        margin-end: 18;

        Box month_bar {
          spacing: 6;

          Button {
            icon-name: "go-previous-symbolic";
            tooltip-text: _("Previous Month");
            action-name: "calendar.previous";
            valign: center;

            accessibility {
              label: _("Previous Month");
            }

            styles [
              "flat",
              "circular",
            ]
          }

          Label month_label {
            width-chars: 14;

            styles [
              "title-4",
            ]
          }

          Button {
            icon-name: "go-next-symbolic";
            tooltip-text: _("Next Month");
            action-name: "calendar.next";
            valign: center;

            accessibility {
              label: _("Next Month");
            }

            styles [
              "flat",
              "circular",
            ]
          }

          Box {
            hexpand: true;
          }

          Button {
            label: _("_Today");
            use-underline: true;
            action-name: "calendar.today";
            valign: center;
          }
        }

        $DandelionMonthCalendar calendar {
          vexpand: true;
          post-activated => $on_calendar_activated();
          post-moved => $on_calendar_moved();
          month-changed => $on_month_changed();
          day-selected => $on_day_selected();
        }

        Box day_box {
          orientation: vertical;
          spacing: 6;
          visible: false;

          Label day_title {
            xalign: 0;

            styles [
              "heading",
            ]
          }

          ListBox day_list {
            selection-mode: none;

            styles [
              "boxed-list",
            ]
          }

          Label day_empty {
            label: _("Nothing planned on this day.");
            wrap: true;
            xalign: 0;

            styles [
              "dim-label",
            ]
          }
        }
      };
    }
  };

  Adw.Breakpoint {
    condition ("max-width: 600sp")

    setters {
      calendar.compact: true;
      calendar.vexpand: false;
      day_box.visible: true;
    }
  }
}

Popover filter_popover {
  child: Box {
    orientation: vertical;
    margin-top: 6;
    margin-bottom: 6;
    margin-start: 6;
    margin-end: 6;
    width-request: 300;

    Adw.PreferencesGroup {
      Adw.ComboRow role_filter {
        title: _("Role");
        notify::selected => $on_filter_changed();
      }

      Adw.ComboRow platform_filter {
        title: _("Platform");
        notify::selected => $on_filter_changed();
      }
    }
  };
}
