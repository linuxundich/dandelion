msgid "Show the drafts sidebar"
msgstr "Seitenleiste mit Entwürfen anzeigen"

#: data/de.linuxundich.Dandelion.gschema.xml:18
msgid "Show the preview column"
msgstr "Vorschauspalte anzeigen"

#: data/de.linuxundich.Dandelion.gschema.xml:19
msgid "Show compact preview tiles"
msgstr "Kompakte Vorschaukacheln anzeigen"

#: data/de.linuxundich.Dandelion.gschema.xml:20
