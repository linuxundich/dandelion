#: data/de.linuxundich.Dandelion.desktop.in:2
#: data/de.linuxundich.Dandelion.metainfo.xml.in:6
msgid "Dandelion"
msgstr "Dandelion"

#: data/de.linuxundich.Dandelion.desktop.in:3
msgid "Social Media Poster"
msgstr "Social-Media-Poster"

#: data/de.linuxundich.Dandelion.desktop.in:4
msgid "Write once, post to Mastodon, Bluesky and more"
msgstr "Einmal schreiben, auf Mastodon, Bluesky und mehr veröffentlichen"

#. Translators: Search terms to find this application. Do NOT translate or localize the semicolons! The list MUST also end with a semicolon!
#: data/de.linuxundich.Dandelion.desktop.in:11
msgid "Mastodon;Bluesky;Fediverse;Social;Post;Crosspost;Toot;"
msgstr "Mastodon;Bluesky;Fediverse;Social;Post;Beitrag;Crossposting;Tröt;"

#: data/de.linuxundich.Dandelion.metainfo.xml.in:7
msgid "Write once, post everywhere"
msgstr "Einmal schreiben, überall veröffentlichen"

#: data/de.linuxundich.Dandelion.metainfo.xml.in:9
msgid "Dandelion lets you write a post once and publish it to several social networks at the same time."
msgstr "Mit Dandelion schreibst du einen Beitrag einmal und veröffentlichst ihn gleichzeitig in mehreren sozialen Netzwerken."

#: data/de.linuxundich.Dandelion.metainfo.xml.in:11
msgid "Roles group your profiles, for example private and work accounts"
msgstr "Rollen bündeln deine Profile, etwa private und berufliche Konten"

#: data/de.linuxundich.Dandelion.metainfo.xml.in:12
msgid "Several accounts per network, such as two Mastodon instances"
msgstr "Mehrere Konten pro Netzwerk, zum Beispiel zwei Mastodon-Instanzen"

#: data/de.linuxundich.Dandelion.metainfo.xml.in:13
msgid "Exact character counters and a preview for every profile"
msgstr "Exakte Zeichenzähler und eine Vorschau für jedes Profil"

#: data/de.linuxundich.Dandelion.metainfo.xml.in:14
msgid "Alt text for images is required where it matters"
msgstr "Alt-Texte für Bilder sind Pflicht, wo es darauf ankommt"

#: data/de.linuxundich.Dandelion.metainfo.xml.in:15
msgid "Credentials are stored in the system keyring"
msgstr "Zugangsdaten liegen im Schlüsselbund des Systems"

#: data/de.linuxundich.Dandelion.metainfo.xml.in:19
msgid "Christoph Langner"
msgstr "Christoph Langner"

#: data/de.linuxundich.Dandelion.metainfo.xml.in:35
msgid "First preview with Mastodon and Bluesky."
msgstr "Erste Vorschau mit Mastodon und Bluesky."

#: data/de.linuxundich.Dandelion.gschema.xml:14
msgid "Window width"
msgstr "Fensterbreite"

#: data/de.linuxundich.Dandelion.gschema.xml:15
msgid "Window height"
msgstr "Fensterhöhe"

#: data/de.linuxundich.Dandelion.gschema.xml:16
msgid "Window maximized"
msgstr "Fenster maximiert"

#: data/de.linuxundich.Dandelion.gschema.xml:17
msgid "Show the drafts sidebar"
msgstr "Seitenleiste mit Entwürfen anzeigen"

#: data/de.linuxundich.Dandelion.gschema.xml:18
msgid "Show the preview column"
msgstr "Vorschauspalte anzeigen"

#: data/de.linuxundich.Dandelion.gschema.xml:19
msgid "Show compact preview tiles"
msgstr "Kompakte Vorschaukacheln anzeigen"

#: data/de.linuxundich.Dandelion.gschema.xml:20
msgid "UUID of the last used role"
msgstr "UUID der zuletzt verwendeten Rolle"

#: data/de.linuxundich.Dandelion.gschema.xml:24
msgid "Require alt text on every platform"
msgstr "Alt-Text auf allen Plattformen verlangen"

#: data/de.linuxundich.Dandelion.gschema.xml:25
msgid "Mastodon always requires alt text. If enabled, missing alt text blocks posting on all platforms instead of only showing a warning."
msgstr "Mastodon verlangt immer einen Alt-Text. Wenn aktiviert, blockiert ein fehlender Alt-Text das Senden auf allen Plattformen, statt nur zu warnen."

#: data/de.linuxundich.Dandelion.gschema.xml:27
msgid "Check spelling"
msgstr "Rechtschreibung prüfen"

#: data/de.linuxundich.Dandelion.gschema.xml:28
msgid "Append the role signature to new posts"
msgstr "Signatur der Rolle an neue Beiträge anhängen"

#: data/de.linuxundich.Dandelion.gschema.xml:30
msgid "Numbering of thread parts"
msgstr "Nummerierung der Thread-Teile"

#: data/de.linuxundich.Dandelion.gschema.xml:34
msgid "Delete empty drafts after this many days (0 = never)"
msgstr "Leere Entwürfe nach so vielen Tagen löschen (0 = nie)"

#: data/de.linuxundich.Dandelion.gschema.xml:37
msgid "Notify on successful scheduled posts"
msgstr "Bei erfolgreich geplanten Beiträgen benachrichtigen"

#: data/de.linuxundich.Dandelion.gschema.xml:38
msgid "Notify on failed scheduled posts"
msgstr "Bei fehlgeschlagenen geplanten Beiträgen benachrichtigen"

#: data/de.linuxundich.Dandelion.gschema.xml:40
msgid "What to do with missed scheduled posts"
msgstr "Umgang mit verpassten geplanten Beiträgen"

#: data/de.linuxundich.Dandelion.gschema.xml:44
msgid "Minutes after which a scheduled post counts as missed"
msgstr "Minuten, nach denen ein geplanter Beitrag als verpasst gilt"

#: data/de.linuxundich.Dandelion.gschema.xml:46
msgid "Default time zone (empty = system)"
msgstr "Standard-Zeitzone (leer = System)"

#: data/de.linuxundich.Dandelion.gschema.xml:48
msgid "Enable AI features"
msgstr "KI-Funktionen aktivieren"

#: data/de.linuxundich.Dandelion.gschema.xml:49
msgid "AI provider (gemini, openai, xai)"
msgstr "KI-Anbieter (gemini, openai, xai)"

#: data/de.linuxundich.Dandelion.gschema.xml:50
msgid "Gemini model"
msgstr "Gemini-Modell"

#: data/de.linuxundich.Dandelion.gschema.xml:51
msgid "OpenAI model"
msgstr "OpenAI-Modell"

#: data/de.linuxundich.Dandelion.gschema.xml:52
msgid "xAI model"
msgstr "xAI-Modell"

#: data/de.linuxundich.Dandelion.gschema.xml:55
msgid "Privacy notices already confirmed"
msgstr "Bereits bestätigte Datenschutzhinweise"

#: data/de.linuxundich.Dandelion.gschema.xml:56
msgid "Entries like “openai:text” or “gemini:images”."
msgstr "Einträge wie „openai:text“ oder „gemini:images“."

