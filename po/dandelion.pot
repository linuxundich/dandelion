#: data/de.linuxundich.Dandelion.metainfo.xml.in:13
msgid ""
"Roles group your profiles, for example private, blog and project accounts"
msgstr ""

#: data/de.linuxundich.Dandelion.metainfo.xml.in:14
msgid "Several accounts per network, such as two Mastodon instances"
msgstr ""

#: data/de.linuxundich.Dandelion.metainfo.xml.in:15
msgid ""
"Exact character counters for every network and a preview for every profile"
msgstr ""

