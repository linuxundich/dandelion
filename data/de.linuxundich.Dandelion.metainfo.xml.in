<?xml version="1.0" encoding="UTF-8"?>
<!-- Copyright 2026 Christoph Langner -->
<component type="desktop-application">
  <id>de.linuxundich.Dandelion</id>
  <metadata_license>CC0-1.0</metadata_license>
  <project_license>GPL-3.0-or-later</project_license>
  <name>Dandelion</name>
  <summary>Write once, post everywhere</summary>
  <description>
    <p>Dandelion lets you write a post once and publish it to several social networks at the same time or at a planned time: Mastodon, Bluesky, LinkedIn, Facebook pages and X.</p>
    <p>Features:</p>
    <ul>
      <li>Roles group your profiles, for example private, blog and project accounts</li>
      <li>Several accounts per network, such as two Mastodon instances</li>
      <li>Exact character counters for every network and a preview for every profile</li>
      <li>Own wording per network or profile where needed</li>
      <li>Alt text is required for Mastodon and suggested everywhere else</li>
      <li>Scheduled posts are sent even when the window is closed</li>
      <li>Optional writing assistant with Google Gemini, OpenAI or xAI that only makes suggestions</li>
      <li>Login data is stored in the system keyring</li>
    </ul>
    <p>LinkedIn, Facebook and X only allow posting through a developer app that you register yourself. X charges per post.</p>
  </description>
  <developer id="de.linuxundich">
    <name>Christoph Langner</name>
  </developer>
  <url type="homepage">https://github.com/linuxundich/dandelion</url>
  <url type="bugtracker">https://github.com/linuxundich/dandelion/issues</url>
  <url type="vcs-browser">https://github.com/linuxundich/dandelion</url>
  <url type="translate">https://github.com/linuxundich/dandelion/tree/main/po</url>
  <launchable type="desktop-id">de.linuxundich.Dandelion.desktop</launchable>
  <translation type="gettext">dandelion</translation>
  <provides>
    <binary>dandelion</binary>
  </provides>
  <categories>
    <category>Network</category>
  </categories>
  <keywords>
    <keyword>Mastodon</keyword>
    <keyword>Bluesky</keyword>
    <keyword>Fediverse</keyword>
    <keyword>Crossposting</keyword>
    <keyword>Social Media</keyword>
    <keyword>Scheduler</keyword>
  </keywords>
  <branding>
    <color type="primary" scheme_preference="light">#99c1f1</color>
    <color type="primary" scheme_preference="dark">#1a5fb4</color>
  </branding>
  <content_rating type="oars-1.1">
    <content_attribute id="social-info">mild</content_attribute>
  </content_rating>
  <requires>
    <display_length compare="ge">360</display_length>
    <internet>always</internet>
  </requires>
  <supports>
    <control>keyboard</control>
    <control>pointing</control>
    <control>touch</control>
  </supports>
  <screenshots>
    <screenshot type="default">
      <caption>Write a post once and see a preview for every profile</caption>
      <image>https://raw.githubusercontent.com/linuxundich/dandelion/main/data/screenshots/composer.png</image>
    </screenshot>
    <screenshot>
      <caption>Plan posts and manage everything that is scheduled</caption>
      <image>https://raw.githubusercontent.com/linuxundich/dandelion/main/data/screenshots/scheduled.png</image>
    </screenshot>
    <screenshot>
      <caption>Optional writing assistant that only makes suggestions</caption>
      <image>https://raw.githubusercontent.com/linuxundich/dandelion/main/data/screenshots/assistant.png</image>
    </screenshot>
    <screenshot>
      <caption>Dark style</caption>
      <image>https://raw.githubusercontent.com/linuxundich/dandelion/main/data/screenshots/composer-dark.png</image>
    </screenshot>
  </screenshots>
  <releases>
    <release version="0.2.2" date="2026-10-03">
      <description>
        <ul>
          <li>The writing assistant asks Gemini and OpenAI for less reasoning and uses fewer tokens</li>
          <li>Images for alt text are scaled down before they are sent</li>
          <li>Gemini thought summaries no longer end up in suggestions</li>
        </ul>
      </description>
    </release>
    <release version="0.2.1" date="2026-10-02">
      <description>
        <ul>
          <li>New icon: the seeds fly away from the dandelion like rays</li>
          <li>Flatpak bundle with translations included</li>
        </ul>
      </description>
    </release>
    <release version="0.2.0" date="2026-10-02">
      <description>
        <ul>
          <li>Long posts can be split into threads on Mastodon, Bluesky and X</li>
          <li>Mastodon posts can be scheduled on the server, so they appear even when the computer is off</li>
          <li>Calendar view for scheduled posts with drag and drop</li>
          <li>Time slots per role and scheduling into the next free slot</li>
        </ul>
      </description>
    </release>
    <release version="0.1.0" date="2026-10-02">
      <description>
        <p>First release.</p>
        <ul>
          <li>Mastodon, Bluesky, LinkedIn, Facebook pages and X</li>
          <li>Roles, profiles, previews and exact character counters</li>
          <li>Scheduled posts with a background service</li>
          <li>Optional writing assistant</li>
        </ul>
      </description>
    </release>
  </releases>
</component>
