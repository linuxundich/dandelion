[Desktop Entry]
Name=Dandelion
GenericName=Social Media Poster
Comment=Write once, post to Mastodon, Bluesky and more
Exec=dandelion %U
Icon=@APP_ID@
Terminal=false
Type=Application
Categories=Network;GTK;GNOME;
