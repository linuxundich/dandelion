{
  "id": "de.linuxundich.Dandelion",
  "runtime": "org.gnome.Platform",
  "runtime-version": "50",
  "sdk": "org.gnome.Sdk",
  "command": "dandelion",
  "separate-locales": false,
  "finish-args": [
    "--share=network",
    "--share=ipc",
    "--socket=fallback-x11",
    "--socket=wayland",
    "--device=dri"
  ],
  "cleanup": [
    "/include",
    "/lib/pkgconfig",
    "/share/pkgconfig",
    "/share/gtk-doc",
    "/share/doc",
    "/share/man",
    "*.la",
    "*.a"
  ],
  "modules": [
    {
      "name": "blueprint-compiler",
      "buildsystem": "meson",
      "cleanup": [
        "*"
      ],
      "sources": [
        {
          "type": "git",
          "url": "https://gitlab.gnome.org/GNOME/blueprint-compiler.git",
          "tag": "v0.22.2"
        }
      ]
    },
    {
      "name": "libportal",
      "buildsystem": "meson",
      "config-opts": [
        "-Dbackend-gtk4=enabled",
        "-Dbackend-gtk3=disabled",
        "-Dbackend-qt5=disabled",
        "-Dbackend-qt6=disabled",
        "-Ddocs=false",
        "-Dtests=false",
        "-Dintrospection=true",
        "-Dvapi=false"
      ],
      "sources": [
        {
          "type": "git",
          "url": "https://github.com/flatpak/libportal.git",
          "tag": "0.11.0"
        }
      ]
    },
    {
      "name": "libspelling",
      "buildsystem": "meson",
      "config-opts": [
        "-Ddocs=false",
        "-Dvapi=false",
        "-Dintrospection=enabled"
      ],
      "sources": [
        {
          "type": "git",
          "url": "https://gitlab.gnome.org/GNOME/libspelling.git",
          "tag": "0.4.10"
        }
      ]
    },
    {
      "name": "dandelion",
      "buildsystem": "meson",
      "sources": [
        {
          "type": "git",
          "url": "https://github.com/linuxundich/dandelion.git",
          "tag": "v0.3.0",
          "commit": "175b19ed66593dede104c04f745abea7f1c32745"
        }
      ]
    }
  ]
}
